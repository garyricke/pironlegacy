# Secrets — never commit
.env
.env.*
*.key

# Dependencies (Netlify installs these at build time)
node_modules/

# Raster assets live on Cloudinary, never in the repo
generated_imgs/
assets/lead-donors/

# OS
.DS_Store

# Internal planning — keep out of the public repo
plan/

# Local Netlify build artifacts
.netlify/
deno.lock

# Scratch
scratchpad/
*.log

# Source photos for the trading-card concepts (news photos — not ours to redistribute)
assets/playing-cards/

# Raw flatbed scans (100MB+ TIFFs) — source material, never committed
assets/*.tiff

# Print rasters + intermediate renders (art lives on Cloudinary; PDFs are the deliverable)
print/card03/*.png
print/card03/*.jpg
print/card03/card03-proof.html

# Scoreboard slide rasters (send as attachments; HTML is the source)
print/scoreboard/*.png
